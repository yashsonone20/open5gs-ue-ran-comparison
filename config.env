# ---------------------------------------------------------------
# 5G KPI bench - configuration
# Every script sources this file.
#
# Switch platform for one command without editing:  PLATFORM=oai ./scripts/run_baseline.sh
# or change the default below.
# ---------------------------------------------------------------
PLATFORM="${PLATFORM:-ueransim}"     # ueransim | oai | freeran

# ---------- Open5GS (shared by every platform) ----------
UPF_GW="10.45.0.1"          # address of ogstun on the host (the "gateway")
UE_SUBNET="10.45.0.0/16"    # UE address pool configured in smf.yaml / upf.yaml
WAN_IF="eth0"               # interface towards the internet (eth0 in WSL)
INTERNET_TARGET="1.0.0.1"   # same target as the earlier pilot measurements

# ---------- UERANSIM ----------
UERANSIM_DIR="$HOME/UERANSIM"
GNB_CFG="$UERANSIM_DIR/config/open5gs-gnb.yaml"
UE_CFG="$UERANSIM_DIR/config/open5gs-ue.yaml"      # has useNamespace: true

# ---------- OAI ----------
OAI_BUILD="$HOME/openairinterface5g/cmake_targets/ran_build/build"
OAI_GNB_CFG="$HOME/oai-config/gnb.conf"
OAI_UE_CFG="$HOME/oai-config/ue.conf"
OAI_NS="oai-ue"                      # created by scripts/04_oai_netns.sh
OAI_RFSIM_SERVER="10.201.1.1"        # host end of the veth link to the UE namespace
OAI_GNB_ARGS="-O $OAI_GNB_CFG --gNBs.[0].min_rxtxtime 6 --rfsim"
OAI_UE_ARGS="-O $OAI_UE_CFG -r 106 --numerology 1 --band 78 -C 3619200000 --ssb 516 --rfsim --rfsimulator.[0].serveraddr $OAI_RFSIM_SERVER"

# ---------- free-ran-ue ----------
FRUE_DIR="$HOME/free-ran-ue"
FRUE_GNB_CFG="$HOME/frue-config/gnb.yaml"
FRUE_UE_CFG="$HOME/frue-config/ue.yaml"
FRUE_NS="frue-ue"                    # created by scripts/05_freeran_netns.sh
FRUE_RAN_IP="10.202.1.1"             # host end of the veth link (gNB's ranControlPlaneIp)

# ---------- Per-platform UE data path (picked automatically) ----------
case "$PLATFORM" in
  ueransim)
    UE_IF="uesimtun0"
    UE_NS="ueransim-999700000000001-internet-psi1"   # created by UERANSIM (useNamespace: true)
    GNB_PROC="nr-gnb";        UE_PROC="nr-ue" ;;
  oai)
    UE_IF="oaitun_ue1"
    UE_NS="$OAI_NS"
    GNB_PROC="nr-softmodem";  UE_PROC="nr-uesoftmodem" ;;
  freeran)
    UE_IF="ueTun0"
    UE_NS="$FRUE_NS"
    GNB_PROC="free-ran-ue";   UE_PROC="free-ran-ue" ;;   # same binary: told apart by "gnb"/"ue" argument
  *) echo "Unknown PLATFORM '$PLATFORM' (use ueransim, oai or freeran)"; exit 1 ;;
esac

# ---------- Measurement settings (identical for every platform) ----------
PING_COUNT=100        # pings per run
PING_INTERVAL=0.2     # seconds between pings
IPERF_DURATION=20     # seconds per iperf3 test
IPERF_UDP_RATE="50M"  # offered load for the UDP loss/jitter test
REPEATS=5             # repeat each ping test this many times
IPERF_REPEATS=3       # repeat each iperf3 test this many times

# Attach test (registration + PDU session), both platforms
ATTACH_ATTEMPTS=10
UE_ATTACH_TIMEOUT=60  # seconds to wait for the UE tunnel to come up

# Multi-UE scaling test. 1/2/4/8 are run on both platforms so they can be compared
# point by point; UERANSIM continues to 20 because it can.
SCALING_STEPS="1 2 4 8 20"          # UERANSIM and free-ran-ue
OAI_SCALING_STEPS="1 2 4 8"         # OAI: each UE simulates the radio (~1.5 CPU cores each)
OAI_SCALING_TIMEOUT=120             # OAI UEs need longer to sync, more so under load
STEADY_STATE_SECS=30

RESULTS_DIR="results"
